{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: CottonGuard AI Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Verify Environment Preflight",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/verify_environment.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Run Benchmark Script",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scratch/run_benchmark.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
