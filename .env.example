# CottonGuard AI Local Environment Configuration Template
APP_NAME="CottonGuard AI"
ENVIRONMENT=local
SECRET_KEY=replace_with_64_char_random_hex_secret
DATABASE_URL=sqlite:///./cotton_leaf_ai.db
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
MAX_UPLOAD_SIZE_MB=10
MIN_IMAGE_DIM=100
